# =============================================================================
# Ultimate Gym Generator — configuration d'environnement
#
# Copier ce fichier en `.env` puis renseigner les valeurs.
# `.env` ne doit JAMAIS être versionné.
# =============================================================================

# --- Django ------------------------------------------------------------------

# Obligatoire. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# False en production, sans exception.
DJANGO_DEBUG=True

# Hôtes autorisés, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Redirige tout HTTP vers HTTPS. False par défaut — ne le passer à True que
# si un reverse proxy TLS transmet bien X-Forwarded-Proto.
DJANGO_SECURE_SSL_REDIRECT=False

# Origines de confiance pour la protection CSRF (schéma compris).
# Exemple derrière un reverse proxy : https://gym.exemple.fr
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5907,http://127.0.0.1:5907

# Port d'écoute (5907 = « sport » en leet).
DJANGO_PORT=5907

# Chemin de l'administration. Le déplacer réduit la surface d'attaque.
DJANGO_ADMIN_URL=admin/

DJANGO_LANGUAGE_CODE=fr-fr
DJANGO_TIME_ZONE=Europe/Paris
DJANGO_LOG_LEVEL=INFO

# --- Base de données ----------------------------------------------------------
#
# SQLite uniquement (voir docs/INSTALL.md). Laisser vide : le fichier est créé
# dans le projet. Ne renseigner que pour déplacer la base ailleurs.

DJANGO_DB_PATH=

# --- Chiffrement des credentials IA -------------------------------------------
#
# Obligatoire. Chiffre les clés d'API stockées en base ; la perdre rend les
# credentials enregistrés illisibles. Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# --- Clés d'IA générative (facultatif) ----------------------------------------
#
# Les credentials se saisissent normalement depuis /settings/ai/, où ils sont
# chiffrés en base. Ces variables servent uniquement à amorcer un environnement
# jetable (CI, démonstration).

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Comptes utilisateurs -----------------------------------------------------
#
# L'application est mono-utilisateur par défaut : seuls les membres du personnel
# créent des comptes depuis /comptes/. Passer à True pour ouvrir l'inscription
# libre depuis la page de connexion.
DJANGO_ALLOW_SELF_REGISTRATION=False

# Répertoire des fichiers déposés (avatars). Laisser vide : reste dans le
# projet (BASE_DIR/media). Ne renseigner que pour le déplacer ailleurs.
DJANGO_MEDIA_ROOT=

# Taille maximale d'un avatar, en octets (2 Mo par défaut).
DJANGO_MAX_AVATAR_BYTES=2097152

# --- Données de santé (Apple HealthKit) ---------------------------------------
#
# Taille maximale d'un export Apple Health importé, en octets (4 Go par
# défaut) — l'import se fait en une seule requête synchrone (issue #70), ce
# plafond en borne la durée. À relever encore si le fichier déposé dépasse
# quand même cette limite (issue #74) — aucune autre limite côté application.
APPLE_HEALTH_IMPORT_MAX_BYTES=4294967296

# --- SSO OpenID Connect (facultatif) ------------------------------------------
#
# Désactivé tant que OIDC_ENABLED n'est pas True : aucune route, aucun bouton.
# Procédure complète — Google et fournisseur générique — dans docs/INSTALL.md.
#
# ⚠️ La connexion Google exige un identifiant et un secret OAuth créés dans
#    Google Cloud Console. Il n'existe aucune variante « sans clé ».

OIDC_ENABLED=False
OIDC_PROVIDER_NAME=SSO

OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile

OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=

# False : seuls les comptes déjà provisionnés peuvent se connecter en SSO.
# True  : un compte est créé automatiquement à la première connexion.
OIDC_CREATE_USER=False
