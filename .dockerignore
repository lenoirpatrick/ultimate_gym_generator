# Secrets — ne doivent jamais entrer dans une image.
.env
*.pem
*.key

# Données persistées du bind mount docker-compose.yml (base SQLite, avatars,
# secret_key et credentials_key générés au démarrage) : jamais dans l'image.
ugg_data/

# Contrôle de version et outillage local
.git
.gitignore
.github
.idea
.vscode

# Environnements et caches Python
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.coverage
coverage.xml
htmlcov

# Artefacts régénérés pendant le build
staticfiles/
core/static/core/css/app.css
db.sqlite3

# Documentation et fichiers Docker eux-mêmes
docs/
*.md
Dockerfile
docker-compose*.yml
.dockerignore
